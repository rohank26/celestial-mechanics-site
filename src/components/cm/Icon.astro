---
// Engraved line icons for Celestial Mechanics, drawn on a 48-unit grid in the
// brand's brass (#D8B25C) with lit details in pale gold (#F2D78E), matching
// the Grand Orrery's point icons.
export const ICON_NAMES = [
  'residence', 'institution', 'business',
  'conversation', 'pavilion', 'heirloom',
  'learn', 'aurora', 'controller',
  'landmark', 'story', 'rocket',
  'system', 'planets', 'mechanism', 'sun', 'craft', 'unique', 'lasting',
] as const;
export type IconName = (typeof ICON_NAMES)[number];
interface Props { name: string; size?: number }
const { name, size = 44 } = Astro.props;

const P = '#F2D78E';
const paths: Record<string, string> = {
  residence: `<path d="M8 40h32"/><path d="M11 40V22L24 11l13 11v18"/><path d="M20 40v-9h8v9"/><circle cx="24" cy="22" r="4.2" stroke="${P}"/><circle cx="24" cy="22" r="1.4" fill="${P}" stroke="${P}"/><ellipse cx="24" cy="22" rx="7.5" ry="2.6" stroke-opacity=".6" stroke-width="1"/>`,
  institution: `<path d="M7 40h34M9 36h30"/><path d="M8 18h32L24 9z"/><path d="M12 18v18M19 18v18M29 18v18M36 18v18" stroke-opacity=".85"/><circle cx="24" cy="14.5" r="1.6" fill="${P}" stroke="${P}"/>`,
  business: `<path d="M8 40h32"/><rect x="12" y="10" width="24" height="30"/><path d="M17 15h4M27 15h4M17 21h4M27 21h4" stroke-opacity=".6"/><circle cx="24" cy="30" r="5.5" stroke="${P}"/><circle cx="24" cy="30" r="1.6" fill="${P}" stroke="${P}"/>`,
  conversation: `<circle cx="24" cy="24" r="5" stroke="${P}"/><circle cx="24" cy="24" r="12" stroke-opacity=".5" stroke-width="1"/><circle cx="10" cy="36" r="3"/><circle cx="38" cy="36" r="3"/><circle cx="24" cy="6.5" r="3"/><path d="M12.5 33.5l4.5-4.5M35.5 33.5L31 29M24 9.5V12" stroke-opacity=".6"/>`,
  pavilion: `<path d="M8 40h32"/><path d="M10 20a14 10 0 0 1 28 0"/><path d="M9 20h30"/><path d="M12 20v20M36 20v20M20 20v20M28 20v20" stroke-opacity=".7"/><path d="M24 10V6" /><circle cx="24" cy="28" r="2.6" fill="${P}" stroke="${P}"/>`,
  heirloom: `<circle cx="24" cy="24" r="15"/><circle cx="24" cy="24" r="11" stroke-opacity=".5" stroke-width="1"/><path d="M24 13v3M24 32v3M13 24h3M32 24h3" stroke-opacity=".7"/><path d="M24 24l5-6" stroke="${P}"/><circle cx="24" cy="24" r="1.6" fill="${P}" stroke="${P}"/>`,
  learn: `<path d="M24 14c-4-3-10-4-16-3v24c6-1 12 0 16 3 4-3 10-4 16-3V11c-6-1-12 0-16 3z"/><path d="M24 14v24" stroke-opacity=".6"/><circle cx="16" cy="22" r="2.4" stroke="${P}"/><circle cx="32" cy="22" r="2.4" stroke="${P}"/>`,
  aurora: `<path d="M8 16V8h8M32 8h8v8M40 32v8h-8M16 40H8v-8" stroke="${P}"/><circle cx="24" cy="24" r="3.4" fill="${P}" stroke="${P}"/><ellipse cx="24" cy="24" rx="12" ry="5" stroke-dasharray="2 2"/><path d="M33 20l4-4h4" stroke-width="1" stroke-opacity=".7"/>`,
  controller: `<path d="M24 40V26"/><path d="M18 40h12"/><path d="M11 26l26-8v-5L11 21z"/><circle cx="24" cy="19" r="2.6" stroke="${P}"/><circle cx="27" cy="18" r="1" fill="${P}" stroke="${P}"/>`,
  landmark: `<path d="M24 6l3 8h8l-6.5 5 2.5 8L24 22l-7 5 2.5-8L13 14h8z" stroke="${P}"/><path d="M10 40h28M14 40l3-9h14l3 9" stroke-opacity=".85"/>`,
  story: `<circle cx="24" cy="24" r="14"/><path d="M24 10v28M10 24h28" stroke-opacity=".35" stroke-width="1"/><path d="M14 30c4-8 16-8 20-12" stroke="${P}"/><circle cx="34" cy="18" r="2" fill="${P}" stroke="${P}"/>`,
  rocket: `<path d="M24 6c6 5 8 12 7 21h-14c-1-9 1-16 7-21z"/><circle cx="24" cy="18" r="3" stroke="${P}"/><path d="M17 27l-5 6 5 1M31 27l5 6-5 1"/><path d="M21 31l-1 7M27 31l1 7M24 31v9" stroke="${P}" stroke-opacity=".8"/>`,
  system: `<circle cx="24" cy="24" r="4" fill="${P}" stroke="${P}"/><circle cx="24" cy="24" r="10" stroke-opacity=".55" stroke-width="1"/><circle cx="24" cy="24" r="17" stroke-opacity=".55" stroke-width="1"/><circle cx="31" cy="17" r="2.2" fill="#0D0A06"/><circle cx="12" cy="31" r="3" fill="#0D0A06"/>`,
  planets: `<circle cx="14" cy="28" r="5"/><circle cx="31" cy="24" r="10"/><ellipse cx="31" cy="24" rx="15" ry="4" stroke="${P}" transform="rotate(-18 31 24)"/><path d="M27.5 19.5a5 5 0 0 1 4-1.5" stroke="${P}"/>`,
  mechanism: `<circle cx="20" cy="22" r="9"/><circle cx="20" cy="22" r="2.5" stroke="${P}"/><path d="M20 10v3M20 31v3M8 22h3M29 22h3M11.5 13.5l2 2M26.5 28.5l2 2M11.5 30.5l2-2M26.5 15.5l2-2" stroke-opacity=".8"/><circle cx="34" cy="34" r="5" stroke="${P}"/>`,
  sun: `<circle cx="24" cy="24" r="7" stroke="${P}"/><circle cx="24" cy="24" r="2.5" fill="${P}" stroke="${P}"/><path d="M24 8v5M24 35v5M8 24h5M35 24h5M12.7 12.7l3.5 3.5M31.8 31.8l3.5 3.5M12.7 35.3l3.5-3.5M31.8 16.2l3.5-3.5" stroke-opacity=".8"/>`,
  craft: `<path d="M12 36l14-14"/><path d="M24 20l6-6 4 4-6 6z" stroke="${P}"/><path d="M10 38l4-1-3-3z"/><circle cx="34" cy="34" r="5" stroke-opacity=".6"/>`,
  unique: `<path d="M24 7l4.5 12.5L41 24l-12.5 4.5L24 41l-4.5-12.5L7 24l12.5-4.5z" stroke="${P}"/><circle cx="24" cy="24" r="3"/>`,
  lasting: `<path d="M16 8h16M16 40h16"/><path d="M17 8c0 9 14 10 14 16s-14 7-14 16M31 8c0 9-14 10-14 16s14 7 14 16"/><path d="M20 36h8l-4-5z" fill="${P}" stroke="${P}"/>`,
};
const body = paths[name] ?? '';
---
<svg class="cm-icon" viewBox="0 0 48 48" width={size} height={size} fill="none" stroke="#D8B25C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><Fragment set:html={body} /></svg>
